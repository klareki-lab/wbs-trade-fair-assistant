# WBS-TF real-AI isolated stack — Owner fills OPENAI_API_KEY only.
# Save as demo/real-ai/.env (gitignored). File is read by start.sh.

# REQUIRED — Owner-provided staging OpenAI key with a project spending cap.
OPENAI_API_KEY=

# OPTIONAL — override defaults.
# N8N_PORT=5679                                  # loopback-only exposed port
# N8N_ENCRYPTION_KEY=demo-rc-n8n-encryption-key-32char
# HEADER_AUTH_KEY=                               # auto-generated per run if unset
# AI_CTX_LOGIN=synthetic_context_login
# AI_CTX_PASSWORD=synthetic-local-only
# PG_CT=wbs-tf-demo-pg
# PG_PORT=15432
