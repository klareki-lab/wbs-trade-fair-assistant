# Example only. The real production env file lives on the VPS at
# /opt/wbs-trade-fair/secrets/gateway.env with mode 0600 and must never be
# committed. The values below show the shape expected after Gate F3B.

# Loopback bind; HTTPS termination is done by nginx on 443.
HOST=127.0.0.1
PORT=3000

# Exact HTTPS origin for the strict Origin check and Secure cookies.
# Changing this value flips the session cookie's Secure attribute on.
APP_ORIGIN=https://messe.klare-ki.de

# Form access key (unchanged from the live deployment unless rotated).
TRADE_FAIR_ACCESS_KEY=<rotate-or-reuse-current-value>

# Session HMAC secret (unchanged from the live deployment unless rotated).
SESSION_SECRET=<rotate-or-reuse-current-value>

# n8n signing header for internal capture/status forwards (unchanged).
N8N_HEADER_KEY=<rotate-or-reuse-current-value>

# n8n upstreams for the existing workflows (unchanged).
N8N_CAPTURE_URL=http://127.0.0.1:5678/webhook/trade-fair/lead
N8N_STATUS_URL=http://127.0.0.1:5678/webhook/trade-fair/status

# Public form stays disabled.
PUBLIC_FORM_ENABLED=false

# WBS-TF-04 Dashboard (enable only when the production dashboard role + function
# are installed under an approved production migration, and the admin key is
# distinct from TRADE_FAIR_ACCESS_KEY).
DASHBOARD_ENABLED=true
DASHBOARD_ACCESS_KEY=<new-admin-only-key>
DASHBOARD_DATABASE_URL=<postgres://trade_fair_dashboard:...@<prod-neon-host>/neondb?sslmode=require&channel_binding=require>
