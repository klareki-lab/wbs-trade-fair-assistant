      "parameters": {
        "jsCode": "// chainLlm 1.7 + structured parser 1.3 returns an object; also unwrap the parser output key.\nconst input = $input.first().json;\nconst result = input.output ?? input;\nconst notes = $('Eingabe prüfen').first().json.notes;\nif (!result || typeof result !== 'object' || !result.extracted || !result.evidence) throw new Error('EXTRACT_SCHEMA_INVALID');\nconst limits = {company_name:200,contact_name:160,email:254,phone:40,website:2048,training_interest:64,budget_status:64,follow_up:64,follow_up_date:10,notes:10000,summary:2000};\nconst enums = {training_interest:['leadership','communication','sales','project_management','digital_skills','ai_automation','other'],budget_status:['approved','planned','unknown','not_disclosed','no_budget'],follow_up:['within_one_week','within_two_weeks','within_one_month','on_date','no_follow_up','not_decided']};\nconst extracted = {}, uncertainty_flags = [];\nfor (const [k,max] of Object.entries(limits)) {\n const value = result.extracted[k], evidence = result.evidence[k];\n const valid = typeof value === 'string' && value.length > 0 && [...value].length <= max && !/[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]/u.test(value) && typeof evidence === 'string' && evidence.length > 0 && notes.includes(evidence) && (!enums[k] || enums[k].includes(value)) && (!['company_name','contact_name','email','phone','website'].includes(k) || evidence.toLowerCase().includes(value.toLowerCase()));\n extracted[k] = valid ? value : null;\n if (value != null && !valid) uncertainty_flags.push('unsupported_' + k);\n}\n// Preserve the user's own note rather than treating an AI paraphrase as original evidence.\nextracted.notes = notes;\nreturn [{json:{success:true,extracted,confidence:{},uncertainty_flags,assistant_message:'Jeden Wert prüfen und vor der Übertragung bestätigen.'}}];"
      },
