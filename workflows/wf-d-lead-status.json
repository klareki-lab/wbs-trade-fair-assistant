      {
        "parameters": {
          "jsCode": "const b=$input.first().json.body;const valid=b&&typeof b==='object'&&!Array.isArray(b)&&Object.keys(b).length===2&&/^FAIR-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/.test(b.lead_id||'')&&/^[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$/.test(b.submission_id||'');return [{json:valid?{valid:true,lead_id:b.lead_id,submission_id:b.submission_id}:{valid:false,http_status:400,response_body:{success:false,error:{code:'INVALID_STATUS_REQUEST',message:'A lead identifier and its submission identifier are required.'}}}}];"
