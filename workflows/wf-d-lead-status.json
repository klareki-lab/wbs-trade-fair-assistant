      {
        "parameters": {
          "jsCode": "const x=$input.first().json;const unavailable={http_status:503,response_body:{success:false,error:{code:'STATUS_UNAVAILABLE',message:'Status is temporarily unavailable.'}}};if(x.valid===false&&x.http_status===400)return [{json:x}];const r=x.status_result;if(r?.success===false&&r?.error?.code==='NOT_FOUND')return [{json:{http_status:404,response_body:{success:false,error:{code:'NOT_FOUND',message:'Lead not found.'}}}}];if(r?.success!==true||!/^FAIR-[a-f0-9-]{36}$/.test(r.lead_id||'')||!['pending','processing','completed','failed'].includes(r.processing_status)||!(r.email_status===null||['pending','leased','sending','delivered','uncertain','failed'].includes(r.email_status)))return [{json:unavailable}];const body={success:true};for(const k of ['lead_id','processing_status','processing_attempts','next_retry_at','last_error_code','review_required','score_band','score_total','email_status','email_next_retry_at','updated_at'])body[k]=r[k]??null;return [{json:{http_status:200,response_body:body}}];"
