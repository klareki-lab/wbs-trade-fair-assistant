# Copy to a private environment file outside version control. Node does not
# load this example automatically. Supply real values only in your environment.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
TRADE_FAIR_ACCESS_KEY=
SESSION_SECRET=
N8N_CAPTURE_URL=
N8N_STATUS_URL=
N8N_HEADER_KEY=
PUBLIC_FORM_ENABLED=false
DASHBOARD_ENABLED=false
DASHBOARD_DATABASE_URL=
DASHBOARD_ACCESS_KEY=
# Full Messe Hub CRM is available when Dashboard is enabled; false is an app-only rollback.
MESSE_CRM_ENABLED=true
# Optional AI: provision both together. Defaults to the capture upstream origin.
N8N_AI_EXTRACT_URL=
N8N_AI_ASK_URL=
N8N_AI_ALLOWED_ORIGIN=
