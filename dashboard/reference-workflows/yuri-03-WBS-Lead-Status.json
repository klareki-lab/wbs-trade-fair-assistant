      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "d1f06f8b-d315-4618-a8b7-de6cf2e3f5b8",
              "leftValue": "={{ $json.valid === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "099ff34e-217c-4791-a6a7-c7e9e1e38f3e",
      "name": "Read Processing Status",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        720,
        -100
      ],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "SELECT trade_fair.get_lead_status($1::text,$2::text) AS status_result;",
        "options": {
          "queryReplacement": "={{ [$json.lead_id,$json.submission_id] }}",
          "queryBatching": "single",
          "connectionTimeout": 10
        }
      },
      "onError": "continueErrorOutput",
      "alwaysOutputData": true,
